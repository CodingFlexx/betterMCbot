# Pflicht
DISCORD_TOKEN=""

# Minecraft-Server (optional — ohne diese Werte laufen nur die Discord-Features)
SERVER_IP=""
RCON_PORT="25575"
RCON_PASSWORD=""
QUERY_PORT="25565"

# Startwerte. Alles hier lässt sich später per Slash-Command überschreiben;
# die Overrides landen in config.json und haben dann Vorrang.
CHAT_CHANNEL_ID=""
GITHUB_REPO=""                        # owner/repo
GITHUB_UPDATES_CHANNEL_ID=""
GITHUB_POLL_INTERVAL_SECONDS="120"
MESSAGE_CLEANUP_RETENTION_HOURS="48"
MESSAGE_CLEANUP_INTERVAL_MINUTES="60"
TIMEZONE="Europe/Berlin"
COUNTDOWN_TARGET_ISO=""

# Öffentliche Join-Adresse, die mc!ip ausgibt und in die Timer-Nachricht wandert.
# Nicht SERVER_IP — das ist der RCON-Host und kann eine interne Adresse sein.
# Vor Ablauf des Countdowns gibt der Bot sie nicht heraus.
SERVER_ADDRESS=""

# Webhooks — nur setzen, wenn der Container von außen erreichbar ist.
# Ist GITHUB_WEBHOOK_SECRET gesetzt, wird das GitHub-Polling abgeschaltet.
GITHUB_WEBHOOK_SECRET=""
MC_WEBHOOK_SECRET=""
WEBHOOK_PORT="8080"

# Nur für lokale Läufe ohne Docker relevant (im Container: /data/config.json)
CONFIG_PATH="config.json"
